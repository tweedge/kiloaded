#!/bin/sh
# Test double for systemctl. Records every call and can fail selected calls.
printf '%s\n' "$*" >>"${FAKE_SYSTEMCTL_LOG:-/dev/null}"

if [ -n "${FAKE_SYSTEMCTL_FAIL:-}" ]; then
    case "$*" in
        *"${FAKE_SYSTEMCTL_FAIL}"*) exit 1 ;;
    esac
fi

if [ -n "${FAKE_SYSTEMCTL_FAIL_ONCE:-}" ]; then
    case "$*" in
        *"${FAKE_SYSTEMCTL_FAIL_ONCE}"*)
            mark="${FAKE_SYSTEMCTL_ONCE_MARK:-/tmp/kiloaded-systemctl-once}"
            if [ ! -e "$mark" ]; then
                : >"$mark"
                exit 1
            fi
            ;;
    esac
fi

if [ "${FAKE_SYSTEMCTL_ACTIVE_ONCE:-0}" = "1" ]; then
    case "$1 $2" in
        "--user is-active")
            mark="${FAKE_SYSTEMCTL_ACTIVE_ONCE_MARK:-/tmp/kiloaded-systemctl-active-once}"
            if [ ! -e "$mark" ]; then
                : >"$mark"
                exit 0
            fi
            exit 1
            ;;
    esac
fi

case "$1 $2" in
    "--user is-active")
        [ "${FAKE_SYSTEMCTL_ACTIVE:-1}" = "1" ]
        ;;
    "--user is-enabled")
        [ "${FAKE_SYSTEMCTL_ENABLED:-1}" = "1" ]
        ;;
    "--user is-failed")
        if [ "${FAKE_SYSTEMCTL_ACTIVE:-1}" = "1" ]; then
            exit 1
        fi
        exit 0
        ;;
    *)
        exit 0
        ;;
esac
